# Reference only. Export these settings or set them in your hosting dashboard.
# This application does not auto-load .env files.
MAIL_PROVIDER=resend
MAIL_FROM=NaV12 <security@your-verified-domain.example>
RESEND_API_KEY=replace-in-hosting-settings
PUBLIC_BASE_URL=http://127.0.0.1:5001
# SMTP alternative:
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=replace-in-hosting-settings
# Production uses PUBLIC_BASE_URL=https://your-real-host and APP_ENV=production.
# Keep your existing SECRET_KEY and DATABASE_URL. Never commit real credentials.
